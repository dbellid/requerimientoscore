# Copie estas variables en Netlify: Site configuration > Environment variables
# Usuarios: agregue tantos pares como necesite (1, 2, 3, ...). Se admiten huecos en la numeración.
ADMIN_NAME1=dbellido
ADMIN_PASSWORD1=cambie-esta-clave
ADMIN_NAME2=usuario2
ADMIN_PASSWORD2=otra-clave-segura

# Firma de las sesiones (recomendado): cadena aleatoria de 32+ caracteres
SESSION_SECRET=reemplace-por-una-cadena-aleatoria-larga
# Duración de la sesión en horas (opcional, 1-72; por defecto 10)
SESSION_HOURS=10

# IA (opcional): sin esta variable los botones de IA quedan deshabilitados
ANTHROPIC_API_KEY=
# Modelo (opcional; por defecto claude-sonnet-5-5) y límite de salida (opcional)
ANTHROPIC_MODEL=
# Solo si la API key no está asignada a un workspace (empieza con wrkspc_)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MAX_TOKENS=16000
